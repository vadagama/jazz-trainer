{
  "name": "amazilia-studio",
  "framework": null,
  "buildCommand": "cd ../.. && npm install --no-package-lock && npm run build -w @jazz/web",
  "outputDirectory": "dist",
  "devCommand": "cd ../.. && npm run dev -w @jazz/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://amazilia-api.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
