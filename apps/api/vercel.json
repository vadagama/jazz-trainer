{
  "installCommand": "cd ../.. && npm install --no-package-lock",
  "buildCommand": "cd ../.. && npm run build -w @jazz/api",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
