# =============================================================================
# Переменные окружения — ШАБЛОН (без значений!)
# =============================================================================
# Скопируй в .env и заполни реальными значениями.
# Никогда не коммить .env с реальными секретами!

# --- Vercel ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# --- База данных (Turso) ---
# DATABASE_URL=libsql://...
# DATABASE_AUTH_TOKEN=

# --- OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Email (Resend) ---
# RESEND_API_KEY=

# --- Сессии ---
# SESSION_SECRET=

# --- Vercel Blob ---
# BLOB_READ_WRITE_TOKEN=

# --- Sentry ---
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- API (веб-приложение) ---
# VITE_API_BASE_URL=

# --- Режим разработки ---
# AUTH_DEV_MODE=true
